# ===========================
# Express JS Server - Environment Config
# ===========================

# Port for the Express gateway server (frontend points here)
JS_SERVER_PORT=3000

# FastAPI (py_server) base URL - all AI-ML requests are proxied here
PY_SERVER_URL=http://localhost:8000

# JWT secret - must match the py_server JWT_SECRET_KEY
JWT_SECRET_KEY=cogwiz
JWT_ALGORITHM=HS256

# CORS - comma-separated list of allowed origins
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Database configuration
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=password
DB_NAME=cognitive_wizard
DB_PORT=3306

# MongoDB configuration
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=cognitivewizard

# Redis configuration
REDIS_URL=redis://localhost:6379

# Logging level: error | warn | info | http | debug
LOG_LEVEL=info

# Node environment: development | production
NODE_ENV=development
