# ===========================
# Express JS Server - Environment Config
# ===========================

# Port for the Express gateway server (frontend points here)
JS_SERVER_PORT=3000

# FastAPI (py_server) base URL - all AI-ML requests are proxied here
PY_SERVER_URL=http://localhost:8000

# JWT secret - must match the py_server JWT_SECRET_KEY
JWT_SECRET_KEY=cogwiz
JWT_ALGORITHM=HS256

# CORS - comma-separated list of allowed origins
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Logging level: error | warn | info | http | debug
LOG_LEVEL=info

# Node environment: development | production
NODE_ENV=development
